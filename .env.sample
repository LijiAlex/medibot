# Cloud LLM (Groq free tier: https://console.groq.com/keys)
GROQ_API_KEY=

# Paths (relative to repo root; defaults used if unset)
DATA_DIR=./data
DB_PATH=./data/db/mediassist.db
STORE_DIR=./store

# Silence onnxruntime's telemetry thread, which aborts at interpreter exit (onnxruntime#24579).
# parser.py also sets this default; the env var is here so scripts/tests inherit it.
ORT_DISABLE_TELEMETRY=1

# Optional. Signs the session tokens issued by /login. Leave unset for local runs and a
# fresh random key is generated per process, which means tokens do not survive a restart.
# Set it to any long random string when you want tokens to outlive one server process.
# MEDIBOT_JWT_SECRET=

# Optional. Seconds a /login token stays valid. Default 3600 (one hour). Raise it only
# for a long unattended demo; there is no refresh token, so this is also how long a
# stolen token would keep working.
# MEDIBOT_TOKEN_TTL_SECONDS=3600
