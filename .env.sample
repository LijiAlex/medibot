# Cloud LLM (Groq free tier: https://console.groq.com/keys)
GROQ_API_KEY=

# Paths (relative to repo root; defaults used if unset)
DATA_DIR=./data
DB_PATH=./data/db/mediassist.db
STORE_DIR=./store

# Silence onnxruntime's telemetry thread, which aborts at interpreter exit (onnxruntime#24579).
# parser.py also sets this default; the env var is here so scripts/tests inherit it.
ORT_DISABLE_TELEMETRY=1
